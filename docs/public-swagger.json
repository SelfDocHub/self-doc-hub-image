                        }
                    }
                }
            }
        },
        "/public/v1/versions/{version}/tree": {
            "get": {
                "description": "Returns the manifest of the version: its services and, for each, the tree of folders, tags, endpoints\nand pages in the order of the left menu of the documentation.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "public"
                ],
                "summary": "The menu of a version",
                "parameters": [
