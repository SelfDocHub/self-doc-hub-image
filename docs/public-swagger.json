{
    "swagger": "2.0",
    "info": {
        "description": "Read-only API of the public documentation sites. No sign-in is needed. Every request names the\ndomain the site runs on in the X-Public-Domain header and only gets what is published on that domain:\nthe style and branding of the site and the published versions of the documentation, as small\nready-to-render files. An unknown domain, a hidden version and a missing file all answer the same 404.",
        "title": "docs-hub public API",
        "contact": {},
        "version": "1.0.0"
    },
    "basePath": "/",
    "paths": {
        "/public/v1/branding/{kind}": {
            "get": {
                "description": "The top logo (logo_top), the bottom logo (logo_bottom) or the favicon (favicon) of the domain's style.",
                "produces": [
                    "application/octet-stream"
                ],
                "tags": [
                    "public"
                ],
                "summary": "A picture of the site's branding",
                "parameters": [
                    {
                        "type": "string",
                        "description": "The domain the site runs on",
                        "name": "X-Public-Domain",
                        "in": "header",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "logo_top, logo_bottom or favicon",
                        "name": "kind",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/publicapi.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/public/v1/i18n/{lang}": {
            "get": {
                "description": "Returns the texts of the site's interface (keys \"site.*\") and the captions generated in the\ndocumentation (keys \"export.doc.*\") in one of the languages of the site.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "public"
                ],
                "summary": "Interface texts of the site",
                "parameters": [
                    {
                        "type": "string",
                        "description": "The domain the site runs on",
                        "name": "X-Public-Domain",
                        "in": "header",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "A language of the site",
                        "name": "lang",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/publicapi.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/public/v1/site": {
            "get": {
                "description": "Returns the texts, languages, final design tokens (light and dark scheme), branding, top bar, footer and the\nlist of published versions of the domain named in X-Public-Domain. The first version is the default one.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "public"
                ],
                "summary": "The site of the domain",
                "parameters": [
                    {
                        "type": "string",
                        "description": "The domain the site runs on",
                        "name": "X-Public-Domain",
                        "in": "header",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Preview token that adds a hidden version to the list",
                        "name": "X-Preview-Token",
                        "in": "header"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/publicapi.SiteResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/publicapi.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/publicapi.ErrorResponse"
                        }
                    },
                    "429": {
                        "description": "Too Many Requests",
                        "schema": {
                            "$ref": "#/definitions/publicapi.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/public/v1/versions/{version}/assets/{asset}": {
            "get": {
                "description": "Served with its verified type, nosniff and a policy that forbids scripts. The name carries the hash of\nthe content, so the picture can be cached for a long time.",
                "produces": [
                    "application/octet-stream"
                ],
                "tags": [
                    "public"
                ],
                "summary": "A picture of a text page",
                "parameters": [
                    {
                        "type": "string",
                        "description": "The domain the site runs on",
                        "name": "X-Public-Domain",
                        "in": "header",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Preview token for a hidden version",
                        "name": "X-Preview-Token",
                        "in": "header"
                    },
                    {
                        "type": "string",
                        "description": "Version ID",
                        "name": "version",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "File name from a page",
                        "name": "asset",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/publicapi.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/public/v1/versions/{version}/endpoints/{id}": {
            "get": {
                "description": "Returns the file of the endpoint: description, parameters, request body, responses, errors and examples\n(when the service publishes them), with the overlays chosen for the version already applied.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "public"
                ],
                "summary": "One endpoint of a version",
                "parameters": [
                    {
                        "type": "string",
                        "description": "The domain the site runs on",
                        "name": "X-Public-Domain",
                        "in": "header",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Preview token for a hidden version",
                        "name": "X-Preview-Token",
                        "in": "header"
                    },
                    {
                        "type": "string",
                        "description": "Version ID",
                        "name": "version",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Node ID from the tree",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/publish.PEndpoint"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/publicapi.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/public/v1/versions/{version}/pages/{id}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "public"
                ],
                "summary": "One text page of a version",
                "parameters": [
                    {
                        "type": "string",
                        "description": "The domain the site runs on",
