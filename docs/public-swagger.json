                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/publicapi.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/public/v1/versions/{version}/search": {
            "get": {
                "description": "A simple search over the titles, methods, paths and first lines of the endpoints and pages of one\nversion. Every word of the query must occur; titles rank before paths, paths before descriptions.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "public"
                ],
                "summary": "Search a version",
                "parameters": [
                    {
                        "type": "string",
                        "description": "The domain the site runs on",
                        "name": "X-Public-Domain",
                        "in": "header",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Preview token for a hidden version",
                        "name": "X-Preview-Token",
                        "in": "header"
                    },
                    {
                        "type": "string",
                        "description": "Version ID",
                        "name": "version",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "The words to look for (at least 2 characters)",
                        "name": "q",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "At most this many results (default 30, at most 100)",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/publicapi.SearchResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/publicapi.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/publicapi.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/public/v1/versions/{version}/sitemap": {
            "get": {
                "description": "Lists every endpoint and page of the version with the time the version was last changed.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "public"
                ],
                "summary": "The pages of a version for a sitemap",
                "parameters": [
